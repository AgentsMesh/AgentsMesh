load("//build_defs/web:internal_package.bzl", "internal_npm_package")
load("//build_defs/web:ts.bzl", "ts_project")
load("//build_defs/web:vitest.bzl", "vitest_test")

# Electron adapter — thin glue that lets the desktop renderer talk to
# the N-API addon via typed IPC. Consumed by clients/desktop.
#
# `:electron_adapter` is the ts_project type-check gate. It depends on
# `//:node_modules` for `@agentsmesh/service-interface` types via the
# Bazel-managed link. To avoid a cycle (`@agentsmesh/electron-adapter`
# → :pkg → :electron_adapter → //:node_modules → @agentsmesh/electron-adapter),
# the gate is NOT shipped through :pkg — :pkg only ships raw .ts which
# Next.js/vite compile themselves.
ts_project(
    name = "electron_adapter",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["src/**/*.test.ts"],
    ),
    declaration = False,
    no_emit = True,
    tsconfig = "tsconfig.json",
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/@agentsmesh/proto",
        "//:node_modules/@agentsmesh/service-interface",
        "//:node_modules/@bufbuild/protobuf",
    ],
)

internal_npm_package(
    name = "pkg",
    package_name = "@agentsmesh/electron-adapter",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["src/**/*.test.ts"],
    ),
    dependencies = {
        "@agentsmesh/proto": "*",
        "@agentsmesh/service-interface": "*",
        "@bufbuild/protobuf": "*",
    },
    # `./projections` subpath lets web re-use the proto→viewModel projections
    # without importing the Electron service classes through the top-level entry.
    extra = {
        "exports": {
            ".": "./src/index.ts",
            "./projections": "./src/projections/index.ts",
            "./relay-ipc-contract": "./src/relay-ipc-contract.ts",
        },
    },
    main = "src/index.ts",
)

vitest_test(
    name = "unit",
    size = "small",
    srcs = glob(
        ["src/**/*.test.ts"],
        allow_empty = True,
    ),
    config = "vitest.config.ts",
    data = [
        "tsconfig.json",
        "//:node_modules",
        "//:node_modules/@agentsmesh/proto",
        "//:node_modules/@agentsmesh/service-interface",
        "//:node_modules/@bufbuild/protobuf",
    ] + glob(
        ["src/**/*.ts"],
        exclude = ["src/**/*.test.ts"],
    ),
)

# Renderer relay ownership and baseline routing are a focused coverage boundary;
# older service facades keep their existing package-level test history.
vitest_test(
    name = "relay_coverage",
    size = "small",
    srcs = [
        "src/electron-relay-manager.events.test.ts",
        "src/electron-relay-manager.test.ts",
    ],
    config = "vitest.relay-coverage.config.ts",
    data = [
        "src/electron-relay-manager.fixture.test.ts",
        "src/electron-relay-manager.ts",
        "src/electron-relay-output-routes.ts",
        "src/invoke.ts",
        "src/relay-ipc-contract.ts",
        "tsconfig.json",
        "vitest.config.ts",
        "//:node_modules",
        "//:node_modules/@vitest/coverage-v8",
    ],
    extra_args = [
        "--coverage.enabled",
        "--coverage.reporter=text",
    ],
)
